# ============================================
# SplitPay — пример переменных окружения
# Скопируй в .env и заполни значения
# ============================================

# ---------- Backend ----------
NODE_ENV=development
PORT=3000

# PostgreSQL (локально — docker-compose; прод — AWS RDS)
DATABASE_URL=postgresql://splitpay:splitpay_dev_password@localhost:5432/splitpay?schema=public

# Redis (локально — docker-compose; прод — AWS ElastiCache)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
# Program ID после `anchor deploy`
SPLITPAY_PROGRAM_ID=

# Helius
HELIUS_API_KEY=your-helius-key
HELIUS_WEBHOOK_ID=
HELIUS_WEBHOOK_SECRET=

# Google OAuth (опционально)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# USDC mint (devnet)
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# CORS — comma-separated allowed origins (required in production;
# leave empty in local dev for open CORS)
CORS_ORIGIN=http://localhost:5173

# ---------- Frontend ----------
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000
VITE_SOLANA_RPC=https://api.devnet.solana.com
VITE_SOLANA_NETWORK=devnet
VITE_SPLITPAY_PROGRAM_ID=
