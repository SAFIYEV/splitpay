{
  "name": "splitpay-program",
  "version": "0.1.0",
  "private": true,
  "description": "SplitPay Anchor program - group expense splitting with USDC settlements on Solana",
  "scripts": {
    "build": "anchor build",
    "test": "anchor test",
    "test:skip-build": "anchor test --skip-build",
    "deploy:devnet": "anchor deploy --provider.cluster devnet",
    "deploy:localnet": "anchor deploy --provider.cluster localnet",
    "keys:sync": "anchor keys sync",
    "lint:fix": "prettier */*.js \"*/**/*{.js,.ts}\" -w",
    "lint": "prettier */*.js \"*/**/*{.js,.ts}\" --check"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1"
  },
  "devDependencies": {
    "@solana/spl-token": "^0.4.9",
    "@types/bn.js": "^5.1.6",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "chai": "^4.5.0",
    "mocha": "^10.7.3",
    "prettier": "^3.3.3",
    "ts-mocha": "^10.0.0",
    "typescript": "^5.5.4"
  },
  "packageManager": "yarn@1.22.22"
}
