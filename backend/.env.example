NODE_ENV=development
PORT=3000

# PostgreSQL (locally — root docker-compose.yml; prod — AWS RDS)
DATABASE_URL=postgresql://splitpay:splitpay_dev_password@localhost:5432/splitpay?schema=public

# Redis (locally — root docker-compose.yml; prod — AWS ElastiCache)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=devnet
# Program ID after `anchor deploy`
SPLITPAY_PROGRAM_ID=

# Helius
HELIUS_API_KEY=your-helius-key
HELIUS_WEBHOOK_ID=
HELIUS_WEBHOOK_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# USDC mint (devnet)
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
